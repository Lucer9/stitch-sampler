---
import '../styles/global.css';
import { STITCHES, FAMILIES } from '../lib/stitches.ts';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const full = title === 'Sampler' ? 'Sampler — an animated field guide to embroidery stitches' : `${title} · Sampler`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1612" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="mark" href="/" aria-label="Sampler, home">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M7 29c6-2 9-10 14-13s10 1 8 6-10 3-9-4" fill="none" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round"/><path d="M30 7 13 33" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <span>Sampler</span>
        </a>
        <nav aria-label="Main">
          <button type="button" class="open" popovertarget="stitch-menu">
            Stitches
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 8 10 12.5 14.5 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <a href="/#kit">What you need</a>
        </nav>
      </div>
      <div id="stitch-menu" class="menu" popover>
        <div class="fams">
          {FAMILIES.map((f) => (
            <section>
              <h2 class="eyebrow">{f.name}</h2>
              <ul>
                {STITCHES.map((st, k) => ({ st, k })).filter(({ st }) => st.family === f.name).map(({ st, k }) => (
                  <li>
                    <a href={`/stitches/${st.slug}/`} aria-current={Astro.url.pathname === `/stitches/${st.slug}/` ? 'page' : undefined}>
                      <span class="mini"><canvas data-swatch={st.slug} data-zoom="2.2" aria-hidden="true"></canvas></span>
                      <span class="nm"><span class="num">{String(k + 1).padStart(2, '0')}</span> {st.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <a class="every" href="/#stitches">
          See all 25 with what each is for
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p class="made">
          Made by <a href="https://www.carlosaguirre.workers.dev">Carlos Aguirre Orozco</a>.
          Every stitch here is drawn live in your browser from a list of needle moves. No video, no images.
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  import { mountSwatches } from '../lib/swatch.ts';
  const menu = document.getElementById('stitch-menu')!;
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
  document.fonts.ready.then(() => mountSwatches());
</script>

<style>
  .top {
    padding: 18px 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font: italic 600 24px/1 var(--serif);
    font-variation-settings: 'SOFT' 100, 'opsz' 48;
    letter-spacing: -0.01em;
  }
  .mark svg {
    width: 34px;
    height: 34px;
  }
  nav {
    display: flex;
    gap: 6px;
  }
  nav a,
  .open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: 500 15px/1 var(--sans);
    text-decoration: none;
    color: var(--ink-2);
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  nav a:hover,
  .open:hover,
  :root:has(.menu:popover-open) .open {
    background: var(--paper-2);
    color: var(--ink);
  }
  :root:has(.menu:popover-open) .open svg {
    rotate: 180deg;
  }
  .open svg {
    width: 18px;
    height: 18px;
    transition: rotate 0.2s ease;
  }
  .menu {
    position: fixed;
    inset: 76px 0 auto;
    width: min(1120px, calc(100vw - 32px));
    max-height: calc(100dvh - 92px);
    margin: 0 auto;
    padding: 22px 22px 14px;
    overflow: auto;
    border: 0;
    border-radius: 22px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 30px 80px -24px rgba(50, 30, 10, 0.45), 0 2px 8px rgba(50, 30, 10, 0.08);
    opacity: 0;
    translate: 0 -8px;
    transition: opacity 0.18s ease, translate 0.18s ease, display 0.18s allow-discrete, overlay 0.18s allow-discrete;
  }
  .menu:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  .menu::backdrop {
    background: rgba(30, 20, 10, 0.12);
  }
  .fams {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px 18px;
  }
  .fams h2 {
    margin: 0 0 8px 8px;
  }
  .fams ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .fams a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 4px 8px 4px 4px;
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    font: 500 14.5px/1.2 var(--sans);
    transition: background-color 0.15s ease;
  }
  .fams a:hover,
  .fams a:focus-visible {
    background: var(--paper-2);
  }
  .fams a[aria-current='page'] {
    background: var(--paper-2);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .mini {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    background: #eee2c7;
    box-shadow: inset 0 0 0 1px rgba(60, 40, 15, 0.12);
  }
  .mini canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .nm .num {
    margin-right: 2px;
    color: var(--ink-3);
    font-size: 12.5px;
  }
  .every {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 10px;
    padding: 0 8px;
    font: 600 14.5px/1 var(--sans);
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .every svg {
    width: 18px;
    height: 18px;
  }
  @media (max-width: 1000px) {
    .fams {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .menu {
      inset: 68px 0 auto;
      padding: 16px 12px 10px;
    }
    .fams {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 6px;
    }
    .fams a {
      gap: 8px;
      font-size: 14px;
    }
    .mini {
      width: 38px;
      height: 38px;
    }
  }
  .foot {
    margin-top: 120px;
    padding: 40px 0 56px;
    border-top: 1px solid var(--line);
  }
  .made {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: 15px;
  }
  .made a {
    color: var(--ink);
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
  }
  @media (max-width: 560px) {
    nav a:last-child {
      display: none;
    }
  }
</style>
